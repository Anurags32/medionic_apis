				{
					"name": "Login - Pharmacy Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.accessToken) {",
									"    var branchId = jsonData.data.user.branch_id || (jsonData.data.user.branch ? jsonData.data.user.branch.id : null);",
									"    pm.environment.set(\"token\", jsonData.data.accessToken);",
									"    pm.environment.set(\"ownerToken\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    if (branchId) pm.environment.set(\"branchId\", branchId);",
									"    pm.collectionVariables.set(\"token\", jsonData.data.accessToken);",
									"    pm.collectionVariables.set(\"ownerToken\", jsonData.data.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    if (branchId) pm.collectionVariables.set(\"branchId\", branchId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"owner@medcab.com\",\n  \"password\": \"Medcab@123\"\n}"
						},
