        {
            "name": "👤 Patient Auth",
            "description": "Patient registration and login — NO token required",
            "item": [
                {
                    "name": "Register Patient",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if(pm.response.code === 201){",
                                    "  var json = pm.response.json();",
                                    "  pm.collectionVariables.set('authToken', json.token);",
                                    "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                                    "  pm.collectionVariables.set('patientId', json.data.patientId);",
                                    "  console.log('Patient token saved:', json.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                { "key": "fullName", "value": "Rahul Sharma", "type": "text" },
                                { "key": "email", "value": "rahul@example.com", "type": "text" },
                                { "key": "password", "value": "Rahul1234", "type": "text" },
                                { "key": "phone", "value": "9876543210", "type": "text" },
                                { "key": "dob", "value": "15/06/1995", "type": "text" },
                                { "key": "gender", "value": "male", "type": "text" },
                                { "key": "address", "value": "123 MG Road, Delhi, Delhi, 110001", "type": "text" },
                                { "key": "emergencyPhone", "value": "9876543211", "type": "text" },
                                { "key": "bloodGroup", "value": "O+", "type": "text" },
                                { "key": "medicalConditions", "value": "None", "type": "text" },
                                { "key": "profilePhoto", "type": "file", "src": "", "disabled": true, "description": "Optional profile photo (JPEG/PNG)" }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/patient/register",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "patient", "register"]
                        },
                        "description": "Register a new patient. profilePhoto is optional."
                    }
                },
                {
                    "name": "Login Patient",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if(pm.response.code === 200){",
                                    "  var json = pm.response.json();",
                                    "  pm.collectionVariables.set('authToken', json.token);",
                                    "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                                    "  pm.collectionVariables.set('patientId', json.data.patientId);",
                                    "  console.log('Patient logged in, token saved');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"rahul@example.com\",\n  \"password\": \"Rahul1234\"\n}",
                            "options": { "raw": { "language": "json" } }
